# Server-only configuration. Never put secrets in VITE_* variables.
DATABASE_PATH=data.db
# Generate a long random value. Used only to create the first workspace account.
AUTH_SETUP_TOKEN=
# Online payments are optional; leave blank to keep them disabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Invoice email requires a verified Resend sender and stable public app URL.
RESEND_API_KEY=
INVOICE_FROM_EMAIL=
PUBLIC_APP_URL=
